{
  "version": 2,
  "functions": {
    "api/telegram.js": {
      "maxDuration": 300
    },
    "api/payment-webhook.js": {
      "maxDuration": 60
    },
    "api/index.js": {
      "maxDuration": 30
    },
    "api/reseller.js": {
      "maxDuration": 30
    },
    "api/reseller-data.js": {
      "maxDuration": 30
    },
    "api/set-webhook.js": {
      "maxDuration": 30
    },
    "api/backup-cron.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/reseller",
      "destination": "/api/reseller"
    },
    {
      "source": "/webhook",
      "destination": "/api/telegram"
    },
    {
      "source": "/payment-webhook",
      "destination": "/api/payment-webhook"
    }
  ],
  "crons": [
    {
      "path": "/api/backup-cron",
      "schedule": "0 17 * * *"
    }
  ]
}
