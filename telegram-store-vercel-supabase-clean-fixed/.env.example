# Telegram
BOT_TOKEN=isi_token_bot_dari_BotFather
OWNER_ID=isi_id_telegram_owner
BOT_NAME=iLink.in Store
BOT_USERNAME=isi_username_bot_tanpa_at
CHANNEL_STORE=https://t.me/ilinkinstore
CUSTOMER_SERVICE=t.me/freezeone1
CHANNEL_LOG=@ilinkinstore2
# Opsional. Channel khusus notifikasi referral dan top up. Jika kosong, memakai CHANNEL_LOG.
WALLET_CHANNEL=@ilinkinstore2

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key_supabase

# Payment gateway aktif: autogopay atau pakasir
PAYMENT_PROVIDER=autogopay

# AutoGoPay — salin API Key dari https://autogopay.site/settings
AUTOGOPAY_API_KEY=isi_api_key_autogopay
AUTOGOPAY_BASE_URL=https://v1-gateway.autogopay.site
# Opsional. Jika kosong, pembeli diarahkan kembali ke PUBLIC_URL.
AUTOGOPAY_REDIRECT_URL=https://nama-project.vercel.app

# Pakasir — hanya diperlukan jika PAYMENT_PROVIDER=pakasir
PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_WEBHOOK_SECRET=
PAKASIR_WEBHOOK_REQUIRE_SECRET=false

# URL publik Vercel setelah deploy
PUBLIC_URL=https://nama-project.vercel.app
STORE_URL=https://nama-project.vercel.app
MINIAPP_URL=https://nama-project.vercel.app/reseller

# Rahasia untuk /api/set-webhook dan /api/setup-autogopay
WEBHOOK_SECRET=ganti_dengan_password_random_tanpa_spasi

# Rahasia khusus Vercel Cron / scheduler eksternal.
# Digunakan sebagai header: Authorization: Bearer CRON_SECRET
CRON_SECRET=ganti_dengan_rahasia_cron_yang_berbeda

# Opsional. Jika kosong, sistem memakai WEBHOOK_SECRET untuk token unduh QRIS.
QR_DOWNLOAD_SECRET=ganti_dengan_rahasia_unduh_qris

# Hanya untuk test lokal, jangan true di production
MINIAPP_DEV_MODE=false

# Lisensi Bot Sewa (opsional)
LICENSE_MANAGER_URL=https://telegram-i-linkin-manager.vercel.app
LICENSE_API_SECRET=isi_rahasia_lisensi
LICENSE_BOT_USERNAME=
LICENSE_CHECK_ENABLED=true
LICENSE_FAIL_CLOSED=false
LICENSE_CODE=

# ProdSeller Reseller API (v76)
# Generate API key di panel ProdSeller → API Manager.
PRODSELLER_API_KEY=psk_isi_api_key_reseller
PRODSELLER_BASE_URL=https://prodseller.com/v1
